# Copy to .env only when you want to override these local-development defaults.
COMPOSE_PROJECT_NAME=data-platform-streams

# Source databases
MYSQL_ROOT_PASSWORD=local_mysql_root
MYSQL_DATABASE=inventory
MYSQL_APP_USER=app_user
MYSQL_APP_PASSWORD=local_app_password
MYSQL_DEBEZIUM_USER=debezium
MYSQL_DEBEZIUM_PASSWORD=local_debezium_password
POSTGRES_PASSWORD=local_postgres_password
POSTGRES_DB=appdb
POSTGRES_APP_USER=app_user
POSTGRES_APP_PASSWORD=local_app_password
POSTGRES_DEBEZIUM_USER=debezium
POSTGRES_DEBEZIUM_PASSWORD=local_debezium_password

# SeaweedFS S3 and Iceberg REST catalog
AWS_ACCESS_KEY_ID=seaweedfs
AWS_SECRET_ACCESS_KEY=local_seaweedfs_secret
AWS_REGION=us-east-1
ICEBERG_DATA_WAREHOUSE=s3://platform-artifacts/iceberg

# StarRocks local users
STARROCKS_USER=root
STARROCKS_PASSWORD=
STARROCKS_READER_USER=analytics_reader
STARROCKS_READER_PASSWORD=local_analytics_reader

# Airflow local UI
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow
AIRFLOW_DB_PASSWORD=local_airflow_db_password
AIRFLOW_FERNET_KEY=9qR1M0WG8H8o3YpXP2qgHZYzWr91RAjtQWnE8ZB2xTg=
AIRFLOW_JWT_SECRET=local-only-change-me

# Grafana local UI
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Deterministic generators
RANDOM_SEED=42
EVENTS_PER_SECOND=2
DB_MUTATIONS_PER_SECOND=1

# Local Ollama models (downloaded only by `make ai-models`)
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen3:1.7b
